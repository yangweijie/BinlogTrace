@echo off
REM package.bat -- assemble the release layout of binlog-agent
REM usage: package.bat <destination-dir>
REM layout: exe + runtime dlls + php.ini + ext/php_pdo_mysql.dll + dist/ + vendor/ + bin/dump_worker.php + .env.example
setlocal enabledelayedexpansion
set "SRC=%~dp0"
set "DST=%~f1"
if "%DST%"=="" goto usage
if "%DST%"=="%SRC%" goto usage

echo [package] src=%SRC%
echo [package] dst=%DST%
if not exist "%DST%" mkdir "%DST%"
if not exist "%DST%\ext" mkdir "%DST%\ext"
if not exist "%DST%\bin" mkdir "%DST%\bin"

REM 1) binary + runtime dlls (phpx.dll needs: php8ts, gmp-10, mpfr-6, libmpdec*)
for %%F in (binlog-agent.exe php8ts.dll phpx.dll libmpdec-4.0.1.dll "libmpdec++-4.0.1.dll" gmp-10.dll mpfr-6.dll MSVCP140.dll VCRUNTIME140.dll VCRUNTIME140_1.dll) do (
    if exist "%SRC%%%~F" copy /y "%SRC%%%~F" "%DST%\" >nul
)
REM tpc root keeps the canonical runtime dlls; fall back to it when not built beside the exe
set "TPC=D:\git\php\tpc_v0.9.5_windows_x64"
for %%F in (php8ts.dll phpx.dll libmpdec-4.0.1.dll "libmpdec++-4.0.1.dll" gmp-10.dll mpfr-6.dll MSVCP140.dll VCRUNTIME140.dll VCRUNTIME140_1.dll) do (
    if not exist "%DST%%%~F" if exist "%TPC%\%%~F" copy /y "%TPC%\%%~F" "%DST%\" >nul
)

REM 2) dynamic extensions (sockets is NOT built-in; bcmath IS built-in)
copy /y "%TPC%\ext\php_pdo_mysql.dll" "%DST%\ext\" >nul
copy /y "%TPC%\ext\php_sockets.dll" "%DST%\ext\" >nul

REM 3) frontend build output (clean target first so stale bundles don't linger)
if exist "%DST%\dist" rd /s /q "%DST%\dist"
if exist "%SRC%dist" xcopy "%SRC%dist" "%DST%\dist\" /e /i /q >nul

REM 4) dump worker business logic (plain PHP) + composer vendor (clean targets first)
if exist "%DST%\bin" rd /s /q "%DST%\bin"
if not exist "%DST%\bin" mkdir "%DST%\bin"
copy /y "%SRC%bin\dump_worker.php" "%DST%\bin\" >nul
if exist "%DST%\vendor" rd /s /q "%DST%\vendor"
if exist "%SRC%vendor" xcopy "%SRC%vendor" "%DST%\vendor\" /e /i /q >nul

REM 5) php.ini with package-local extension_dir (absolute path written here)
> "%DST%\php.ini" (
    echo ; binlog-agent runtime ini - generated by package.bat
    echo extension_dir = "%DST%\ext"
    echo extension=php_pdo_mysql.dll
    echo extension=php_sockets.dll
    echo enable_dl = On
)

REM 6) .env template if none present
if not exist "%DST%\.env" copy /y "%SRC%.env.example" "%DST%\.env" >nul

echo [package] done: %DST%
exit /b 0

:usage
echo usage: package.bat ^<destination-dir^>
exit /b 2
