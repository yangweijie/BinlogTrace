#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * bin/agent — 轻量 TypePHP 风格 CLI 入口（类似 think 命令）
 * 启动原生 HTTP 服务，承载 MySQL binlog 追踪代理（不依赖 workerman / thinkphp）。
 *
 * 用法：
 *   php bin/agent serve [--host 0.0.0.0] [--port 8080]
 *   php bin/agent help
 */

$root = dirname(__DIR__);

// 自动加载（先尝试项目 vendor，后回退父级 agent-workerman 的 vendor）
$autoloadCandidates = [
    $root . '/vendor/autoload.php',
    dirname($root) . '/agent-workerman/vendor/autoload.php',
];
$autoloaded = false;
foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        $autoloaded = true;
        break;
    }
}

$args = array_slice($argv, 1);
$cmd = $args[0] ?? 'help';

function printHelp(): void
{
    echo <<<EOT
DMS Agent — 轻量 MySQL binlog 追踪代理（CLI + 原生 HTTP 服务）

用法:
  php bin/agent serve [--host <ip>] [--port <port>]   启动 HTTP 服务（默认 127.0.0.1:8080）
  php bin/agent help                                  显示本帮助

路由（前端对接）:
  POST /connect   测试连接 + 采集元数据，返回 connected 帧（含 session）
  POST /query     session 只读查询
  POST /dump      session 启动 binlog 解析（SSE 长流: dump-started → binlog-change → binlog-end）
  POST /close     销毁会话

注意:
  首次运行需先安装依赖: composer install
  （仅依赖 krowinski/php-mysql-replication，不依赖 workerman / thinkphp）

EOT;
}

if ($cmd === 'help' || $cmd === '--help' || $cmd === '-h') {
    printHelp();
    exit(0);
}

if ($cmd !== 'serve') {
    fwrite(STDERR, "未知命令: {$cmd}\n\n");
    printHelp();
    exit(1);
}

if (!$autoloaded) {
    fwrite(STDERR, "未找到 vendor/autoload.php。请先运行: composer install\n");
    fwrite(STDERR, "候选路径:\n - " . implode("\n - ", $autoloadCandidates) . "\n");
    exit(1);
}

// 解析 --host / --port
$host = '127.0.0.1';
$port = 8080;
for ($i = 1; $i < count($args); $i++) {
    if ($args[$i] === '--host' && isset($args[$i + 1])) {
        $host = $args[++$i];
    } elseif ($args[$i] === '--port' && isset($args[$i + 1])) {
        $port = (int) $args[++$i];
    }
}

if (!class_exists(\DmsAgent\Server::class)) {
    fwrite(STDERR, "类 DmsAgent\\Server 未找到，请确认 composer autoload 与 src/ 路径正确。\n");
    exit(1);
}

$server = new \DmsAgent\Server($host, $port);
$server->run();
